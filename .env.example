# Server-only settings, one .env next to docker-compose.yml in each checkout.
# Never commit the real file: the repository is public.

# --- production (/home/titouan/BLab, branch main) ---
COMPOSE_PROJECT_NAME=blab
BLAB_STAGE=production
HEALTH_URL=https://localhost/admin/login/
DJANGO_SECRET_KEY=<long random string, different per stage>
DB_PASSWORD=<Postgres password of the shared database>
TLS_DIR=/home/titouan/blab-tls
GITHUB_STATUS_TOKEN=<fine-grained token: this repo, Commit statuses read/write>
# Device logins (docs/adr/0004-switch-accounts-and-secret-admin.md). Optional: unset, BLab uses
# the values shown. BLab logs in to lab Switches as admin, trying each password in turn
# (comma-separated, so a password can't hold a comma; write a $ as $$). Put the new admin
# password first once it is changed on the devices, and keep the old ones until every Switch has it.
# BLAB_SWITCH_ADMIN_PASSWORDS=switch,Switch@123
# The Management network: its subnets, each with its gateway, comma-separated. onboard_switches
# scans them (#55); a contributed Switch gets its address in them (#59).
# BLAB_MANAGEMENT_NETWORKS=10.69.144.128/26 via 10.69.144.129
# Backbones keep their own login, apart from the lab Switches'.
# BLAB_BACKBONE_USERNAME=admin
# BLAB_BACKBONE_PASSWORD=switch
# The addresses lab Switches see BLab's logins come from (the server's), comma-separated. The
# nightly Sweep Cleans up a Switch that logged any other login since its last reload.
# BLAB_SOURCE_ADDRESSES=10.69.144.180
# What the nightly Sweep may do. report (the default): it Inspects and reads the logins, and only
# lists on the Lab status page what it would Clean up, Quarantine or lift. enforce: it does it.
# BLAB_SWEEP_MODE=report
# Clean state (docs/adr/0006). report (the default): a Cleanup only lists in the Switch history the
# Unwanted files and local users it would remove and whether it would repair init, and an Inspection
# shows them as warnings. enforce: the Cleanup removes and repairs them, and an Inspection fails on
# what is left. Set it in both .env files once the lab has been told.
# BLAB_CLEAN_STATE_MODE=report
# AOS releases (#48, docs/adr/0011). report (the default): a Cleanup only notes in the Switch history
# the lab release it would install. enforce: a Cleanup of a Switch whose init/ holds another release
# downloads the lab's (once, kept in api/aos_images/) and installs it. Set it in both .env files once
# the lab has been told: each Switch then changes release at its next Cleanup.
# BLAB_AOS_RELEASE_MODE=report
# Missing cables (#57, docs/adr/0009): a Port whose link is down. off (the default): BLab enables no
# UNI, so it only sees Missing cables on the Links of reserved Switches. report: an Inspection of a
# Switch nobody holds also enables the disabled UNIs of its Ports that are down for a few seconds,
# then disables them again, and lists the Missing cables as warnings on the Lab status page.
# enforce: they fail the Inspection, and the Switch is Quarantined naming nobody (an admin clears it).
# BLAB_MISSING_CABLE_MODE=off
# How many Switches the Switch worker moves on at once (#39): their Cleanups and Restores run on
# that many threads, each Switch on one at a time. 1 does them one after another, as before.
# BLAB_SWITCH_WORKER_THREADS=4
# Projects (#34): off (the default) until the maintenance window, then on in both .env files.
# On, every user chooses a Switch password at first login (docs/adr/0004), which BLab stores
# encrypted with BLAB_SWITCH_PASSWORD_KEY: required with BLAB_PROJECTS on (startup stops without
# it), unused while off. Use the same key in both .env files, since both stages push the passwords.
# Generate one with:
#   docker compose run --rm django python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To change it, put the new key first and keep the old one after a comma; never drop a key while
# passwords encrypted with it remain (users would have to choose theirs again).
# Once both stages run with it on, convert the Shares once (docs/adr/0007), safe to run again:
#   docker compose exec django python manage.py convert_shares_to_projects --dry-run
# BLAB_PROJECTS=off
# BLAB_SWITCH_PASSWORD_KEY=<Fernet key>

# --- pre-prod (/home/titouan/BLab-preprod, branch dev): same DB_PASSWORD, TLS_DIR and token, plus ---
# COMPOSE_PROJECT_NAME=blab-preprod
# COMPOSE_FILE=docker-compose.yml:docker-compose.preprod.yml
# BLAB_STAGE=preprod
# HEALTH_URL=https://localhost:8443/admin/login/
# DJANGO_CSRF_TRUSTED_ORIGINS=https://10.69.144.180:8443
